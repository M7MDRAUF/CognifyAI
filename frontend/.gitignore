# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and .env.example IS opted in. ci.yml:170 copies it to .env for compose
# interpolation on a clean checkout; while `.env*` swallowed it that step failed and
# `docker compose config`/`build` were never reached. The root .gitignore already uses
# the precise patterns (.env, .env.local, .env.*.local), which is why
# backend/.env.example has always been tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
