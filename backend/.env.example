# CognifyAI backend configuration. Copy to .env and fill in real values.
# Never commit .env. Secrets live only in environment variables.

APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://cognify:cognify@localhost:5432/cognify
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=cognify_chunks
# Set LLM_PROVIDER=fake for a fully local dry run with no external API calls.
LLM_PROVIDER=openai
LLM_API_KEY=sk-replace-me
LLM_TEXT_MODEL_SMALL=gpt-4o-mini
LLM_TEXT_MODEL_STRONG=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
# Embeddings are pinned to their own provider, independent of LLM_PROVIDER above. Only OpenAI's
# embeddings API is verified in this codebase today — see docs/providers.md.
LLM_EMBEDDING_PROVIDER=openai
MAX_UPLOAD_SIZE_MB=25
MAX_PROJECT_SIZE_MB=250
# Admission control for the query workflow, and the only bound on what an anonymous caller can
# spend. One accepted POST /projects/{id}/queries commits a run that issues 7-20 logical chat
# completions, up to 60 billed HTTP requests. Both settings are read by the loader like every other field
# (`app/core/config.py`) but carry defaults (`Settings`), so leaving them out is
# silent rather than a startup failure -- which is why they are written out here.
# MAX_RUNNING_QUERIES_PER_PROJECT: concurrent runs allowed per project, counted over the
#   deadline window below (`QueryService._reject_if_at_capacity`).
# QUERY_RUN_DEADLINE_SECONDS: wall-clock ceiling on one run, enforced as an asyncio timeout
#   (`_execute_workflow` in `app/workers/jobs.py`); it also defines the window the count above looks back over, so
#   raising it widens the concurrency window as well as lengthening a run.
MAX_RUNNING_QUERIES_PER_PROJECT=3
QUERY_RUN_DEADLINE_SECONDS=600
# QUERY_RUN_LEASE_SECONDS: a running run's lease, renewed by its job every third of this; the
#   reconciler closes a run whose lease lapsed with no live task (`app/services/run_reconciler.py`).
# RUN_RECONCILE_INTERVAL_SECONDS: how often the reconciler runs, after its pass at startup. A run
#   whose process died ends at most the lease plus this interval later.
QUERY_RUN_LEASE_SECONDS=60
RUN_RECONCILE_INTERVAL_SECONDS=30
# INGESTION_LEASE_SECONDS: a document's ingestion lease, renewed by its job every third of this;
#   the same reconciler closes a PROCESSING document whose lease lapsed, so it can be reindexed.
# INGESTION_STALE_AFTER_SECONDS: a PROCESSING document with no lease (written before leases) is
#   closed once its last update is older than this.
INGESTION_LEASE_SECONDS=60
INGESTION_STALE_AFTER_SECONDS=900
UPLOAD_DIR=./data/uploads
# Rollout gate for the opt-in pharmaceutical manufacturing profile (default on). Off, creating a
# pharmaceutical project is refused with domain_profile_disabled (400); General projects and
# existing pharmaceutical projects keep working.
PHARMA_PROFILE_ENABLED=true
# CORS_ALLOWED_ORIGIN: one browser origin, or several separated by commas, each matched exactly.
#   Both spellings of the loopback frontend by default, since the start command prints 127.0.0.1.
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Optional: point the OpenAI-compatible provider at another endpoint (e.g. Ollama).
# LLM_BASE_URL=

# --- Legacy single-provider configuration (still honoured) ---------------------
# LLM_PROVIDER / LLM_API_KEY / LLM_TEXT_MODEL_SMALL / LLM_TEXT_MODEL_STRONG /
# LLM_BASE_URL above apply to whichever provider LLM_PROVIDER names -- including right after you
# change it. A blank LLM_TEXT_MODEL_SMALL/_STRONG correctly falls through to the new provider's
# own default model id, but a stale, non-blank value still wins: switching LLM_PROVIDER from
# openai to nvidia without also clearing LLM_TEXT_MODEL_SMALL=gpt-4o-mini sends that OpenAI model
# id to NVIDIA on every request. Clear these two lines (or set the per-provider
# LLM_<PROVIDER>_MODEL_FAST/_MODEL_POWERFUL below explicitly) when switching providers.

# --- Multi-provider configuration (all optional) -------------------------------
# Set a key to make that provider selectable. Models default to the ids in the
# registry; override them when a vendor ships a new one.
# LLM_OPENAI_API_KEY=sk-replace-me
# LLM_OPENAI_MODEL_FAST=gpt-4o-mini
# LLM_OPENAI_MODEL_POWERFUL=gpt-4o
# LLM_DEEPSEEK_API_KEY=sk-replace-me
# LLM_NVIDIA_API_KEY=nvapi-replace-me
# LLM_GLM_API_KEY=replace-me
# LLM_KIMI_API_KEY=sk-replace-me
# Every provider above also has its own optional _BASE_URL, _MODEL_FAST and _MODEL_POWERFUL
# (e.g. LLM_GLM_BASE_URL for the China platform, LLM_NVIDIA_BASE_URL for a self-hosted NIM
# container). See docs/providers.md for the full per-vendor list and defaults.
# The placeholder keys in this file (sk-replace-me, nvapi-replace-me, replace-me) count as no key:
# a provider keyed with one is reported unavailable and offered nowhere. A local server that
# ignores keys still needs a value, so use any other one, such as `local`.
# Optional: restrict which providers are offered for chat, and pick the default model.
# LLM_ENABLED_PROVIDERS=openai,deepseek
# LLM_DEFAULT_MODEL=openai:gpt-4o
# Optional: restrict which providers may embed document text. Unset, the chat list above applies,
# so set it when chat and embeddings use different providers (chat on DeepSeek only, say, with
# embeddings through the OpenAI dialect at a local server):
# LLM_ENABLED_PROVIDERS=deepseek
# LLM_ENABLED_EMBEDDING_PROVIDERS=openai
